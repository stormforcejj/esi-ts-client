{
    "name": "@indipsyno/esi",
    "version": "1.0.0",
    "description": "An opinionated typescript client for the EvE Online ESI API with caching and rate limiting. Intended for backend use.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "test": "jest",
        "generate:api": "openapi-generator-cli generate -i ./esi.json -g typescript-fetch -o ./src/generated -t ./templates -c .openapi-generator-config.yaml",
        "prebuild": "ts-node scripts/prebuild"
    },
    "author": "James (https://stormforcejj.co.uk)",
    "repository": {
        "type": "git",
        "url": "https://github.com/stormforcejj/esi-ts-client.git"
    },
    "bugs": {
        "url": "https://github.com/stormforcejj/esi-ts-client/issues"
    },
    "homepage": "https://github.com/stormforcejj/esi-ts-client",
    "keywords": [
        "esi",
        "eve",
        "eve online",
        "typescript",
        "api client",
        "indipsyno"
    ],
    "license": "ISC",
    "dependencies": {
        "@keyv/redis": "^5.1.1",
        "bottleneck": "^2.19.5",
        "dotenv": "^17.2.2",
        "jsonwebtoken": "^9.0.2",
        "jwt-decode": "^4.0.0",
        "keyv": "^5.5.0"
    },
    "devDependencies": {
        "@jest/globals": "^30.1.2",
        "@openapitools/openapi-generator-cli": "^2.21.4",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.12.4",
        "@types/node-fetch": "^2.6.13",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "eslint": "^9.33.0",
        "jest": "^30.1.3",
        "msw": "^2.11.1",
        "node-fetch": "^2.7.0",
        "ts-jest": "^29.4.2",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2"
    }
}
